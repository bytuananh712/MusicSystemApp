<Page x:Class="MusicSystem.App.Views.Pages.SongManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý bài hát"
      Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🎵 Quản lý bài hát" 
                       FontSize="24" 
                       FontWeight="Bold"/>
            <TextBlock Text="Thêm, sửa, xóa bài hát trong hệ thống" 
                       FontSize="12" 
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" 
                Background="#FFF8F9FA" 
                Padding="15"
                CornerRadius="5"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="txtSearch" 
                             Width="300" 
                             Height="35"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             FontSize="13"
                             BorderBrush="#FFDEE2E6"
                             BorderThickness="1"/>
                    <Button Content="🔍 Tìm kiếm" 
                            Width="100" 
                            Height="35"
                            Margin="10,0,0,0"
                            Background="#FF6C757D"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnSearch_Click"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnAddSong"
                            Content="➕ Thêm bài hát"
                            Height="35"
                            Padding="20,0"
                            Background="#FF28A745"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnAddSong_Click"/>

                    <Button x:Name="btnRefresh"
                            Content="🔄"
                            Width="35"
                            Height="35"
                            Margin="10,0,0,0"
                            Background="#FF17A2B8"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnRefresh_Click"
                            ToolTip="Làm mới danh sách"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" 
                BorderBrush="#FFDEE2E6" 
                BorderThickness="1"
                CornerRadius="5">
            <DataGrid x:Name="dgSongs"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeight="50"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FFF8F9FA">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tiêu đề" 
                                        Binding="{Binding Title}" 
                                        Width="250"
                                        FontWeight="SemiBold"/>

                    <DataGridTextColumn Header="Nghệ sĩ" 
                                        Binding="{Binding Artists}" 
                                        Width="200"/>

                    <DataGridTextColumn Header="Thể loại" 
                                        Binding="{Binding Genre}" 
                                        Width="100"/>

                    <DataGridTextColumn Header="Thời lượng" 
                                        Binding="{Binding DurationFormatted}" 
                                        Width="80"/>

                    <DataGridTextColumn Header="Lượt nghe" 
                                        Binding="{Binding TotalPlays}" 
                                        Width="80"/>

                    <DataGridTemplateColumn Header="Trạng thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="3"
                                        Padding="8,3">
                                    <TextBlock Foreground="White" 
                                               FontSize="11"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Status}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Text" Value="Chờ Admin duyệt" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Active">
                                                        <Setter Property="Text" Value="Đã duyệt" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                        <Setter Property="Text" Value="Bị từ chối" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Thao tác" Width="*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️ Sửa" 
                                            Padding="10,3"
                                            Margin="2"
                                            Background="#FFFFC107"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="btnEdit_Click"
                                            Tag="{Binding SongId}"/>

                                    <Button Content="🗑️ Xóa" 
                                            Padding="10,3"
                                            Margin="2"
                                            Background="#FFDC3545"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="btnDelete_Click"
                                            Tag="{Binding SongId}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" 
                Background="#FFF8F9FA"
                Padding="15"
                Margin="0,15,0,0"
                CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="txtStatus" 
                           Text="Tổng: 0 bài hát"
                           FontSize="12"
                           Foreground="Gray"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>