<Page x:Class="MusicSystem.App.Views.Pages.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="680" d:DesignWidth="1050"
      Title="AdminDashboardPage"
      Loaded="Page_Loaded"
      Background="#1E1E2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#181825" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="txtDashboardTitle" Text="🛡 Admin Dashboard" FontSize="20" FontWeight="Bold"
                               Foreground="#CBA6F7" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock x:Name="txtWelcome" Foreground="#A6ADC8"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <TabControl Grid.Row="1" Background="#1E1E2E" BorderThickness="0"
                    Margin="16,12,16,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Foreground" Value="#A6ADC8"/>
                    <Setter Property="Padding" Value="14,7"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#CBA6F7"/>
                            <Setter Property="Foreground" Value="#1E1E2E"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: STATISTICS -->
            <TabItem Header="📊 Thống kê">
                <StackPanel Margin="0,16,0,0">
                    <!-- QUICK ACTIONS -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="btnManageUsers"
                                Content="👥 Quản lý người dùng" Padding="14,8"
                                Background="#313244" Foreground="#CDD6F4"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                                Click="btnUserMgmt_Click"/>
                        <Button Content="🔄 Làm mới" Padding="14,8"
                                Background="#313244" Foreground="#A6ADC8"
                                BorderThickness="0" Cursor="Hand"
                                Click="btnRefresh_Click"/>
                    </StackPanel>

                    <!-- STAT CARDS -->
                    <UniformGrid Columns="4">
                        <Border Background="#313244" CornerRadius="10" Margin="0,0,10,0" Padding="20">
                            <StackPanel>
                                <TextBlock Text="👥 Tổng người dùng" Foreground="#A6ADC8" FontSize="12"/>
                                <TextBlock x:Name="txtTotalUsers" Text="--" FontSize="40"
                                           FontWeight="Bold" Foreground="#89DCEB" Margin="0,8,0,4"/>
                                <TextBlock x:Name="txtNewUsers" Text="" Foreground="#6C7086" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#313244" CornerRadius="10" Margin="0,0,10,0" Padding="20">
                            <StackPanel>
                                <TextBlock Text="✅ Đang hoạt động" Foreground="#A6ADC8" FontSize="12"/>
                                <TextBlock x:Name="txtActiveUsers" Text="--" FontSize="40"
                                           FontWeight="Bold" Foreground="#A6E3A1" Margin="0,8,0,4"/>
                                <TextBlock Text="Tài khoản Active" Foreground="#6C7086" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#313244" CornerRadius="10" Margin="0,0,10,0" Padding="20">
                            <StackPanel>
                                <TextBlock Text="🎵 Tổng bài hát" Foreground="#A6ADC8" FontSize="12"/>
                                <TextBlock x:Name="txtTotalSongs" Text="--" FontSize="40"
                                           FontWeight="Bold" Foreground="#CBA6F7" Margin="0,8,0,4"/>
                                <TextBlock Text="Trong hệ thống" Foreground="#6C7086" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#313244" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="🎤 Tổng nghệ sĩ" Foreground="#A6ADC8" FontSize="12"/>
                                <TextBlock x:Name="txtTotalArtists" Text="--" FontSize="40"
                                           FontWeight="Bold" Foreground="#FAB387" Margin="0,8,0,4"/>
                                <TextBlock Text="Đã đăng ký" Foreground="#6C7086" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </TabItem>

            <!-- TAB 2: SONG APPROVAL -->
            <TabItem x:Name="tabSongApproval" Header="⏳ Duyệt bài hát">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar duyệt -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 Tải lại" Padding="12,6"
                                Background="#313244" Foreground="#CDD6F4"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                Click="btnLoadPending_Click"/>
                        <Button x:Name="btnApproveSong" Content="✅ Duyệt" Padding="14,6"
                                Background="#A6E3A1" Foreground="#1E1E2E" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                IsEnabled="False" Click="btnApproveSong_Click"/>
                        <Button x:Name="btnRejectSong" Content="❌ Từ chối" Padding="14,6"
                                Background="#F38BA8" Foreground="#1E1E2E" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"
                                IsEnabled="False" Click="btnRejectSong_Click"/>

                        <TextBlock x:Name="txtPendingCount" Text="" Foreground="#F9E2AF"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- DataGrid bài chờ duyệt -->
                    <DataGrid Grid.Row="1" x:Name="dgPendingSongs"
                              Background="#313244" Foreground="#CDD6F4"
                              BorderBrush="#45475A" BorderThickness="1"
                              RowBackground="#313244" AlternatingRowBackground="#2A2A3E"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#45475A"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserResizeColumns="True"
                              SelectionChanged="dgPendingSongs_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Nghệ sĩ" Binding="{Binding Artists}" Width="160"/>
                            <DataGridTextColumn Header="Thể loại" Binding="{Binding Genre}" Width="110"/>
                            <DataGridTextColumn Header="Năm" Binding="{Binding ReleaseYear}" Width="60"/>
                            <DataGridTextColumn Header="Thời lượng" Binding="{Binding DurationFormatted}" Width="80"/>
                            <DataGridTextColumn Header="File" Binding="{Binding FileUrl}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Hướng dẫn -->
                    <Border Grid.Row="2" Background="#1E1E2E" Padding="0,8,0,0">
                        <TextBlock Foreground="#6C7086" FontSize="11"
                                   Text="💡 Chọn một bài hát → bấm ✅ Duyệt để phát hành (Active) hoặc ❌ Từ chối (Inactive)"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#181825" Padding="20,8">
            <TextBlock x:Name="txtStatus" Text="Sẵn sàng" Foreground="#6C7086"/>
        </Border>
    </Grid>
</Page>
