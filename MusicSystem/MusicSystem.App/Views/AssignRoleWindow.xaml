<Window x:Class="MusicSystem.App.Views.AssignRoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin vai trò" 
        Height="420" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔑 Thông tin vai trò người dùng" 
                       FontSize="18" 
                       FontWeight="Bold"/>
            <TextBlock x:Name="txtUserInfo" 
                       Text="Username: ..." 
                       FontSize="12" 
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Role Display -->
        <Border Grid.Row="1" 
                BorderBrush="#FFDEE2E6" 
                BorderThickness="1"
                CornerRadius="5"
                Padding="15">
            <StackPanel>
                <TextBlock Text="Vai trò hiện tại:" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,12"/>

                <ItemsControl x:Name="lstRoles">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F0FFF4" 
                                    BorderBrush="#86EFAC" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="10,6" 
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅ " FontSize="13"/>
                                    <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="txtNoRole"
                           Text="Chưa có vai trò nào được gán."
                           FontSize="12"
                           Foreground="Gray"
                           FontStyle="Italic"
                           Visibility="Collapsed"/>

                <TextBlock Text="💡 Vai trò được quản lý bởi hệ thống. Liên hệ Admin để thay đổi." 
                           FontSize="11" 
                           Foreground="Gray"
                           FontStyle="Italic"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Button -->
        <Button Grid.Row="2"
                x:Name="btnClose"
                Content="Đóng"
                Height="40"
                Margin="0,20,0,0"
                Background="#FF6C757D"
                Foreground="White"
                FontSize="14"
                BorderThickness="0"
                Cursor="Hand"
                Click="btnClose_Click"/>
    </Grid>
</Window>