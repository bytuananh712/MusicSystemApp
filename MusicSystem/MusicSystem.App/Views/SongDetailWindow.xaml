<Window x:Class="MusicSystem.App.Views.SongDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết bài hát" 
        Height="500" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="🎵 Chi tiết bài hát" 
                           FontSize="20" 
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Info Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tiêu đề:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtTitle" Text="..." Margin="0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Nghệ sĩ:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtArtists" Text="..." Margin="0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Thể loại:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtGenre" Text="..." Margin="0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Thời lượng:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtDuration" Text="..." Margin="0,5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Kích thước:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtFileSize" Text="..." Margin="0,5"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Format:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtFormat" Text="..." Margin="0,5"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Upload lúc:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="txtCreatedAt" Text="..." Margin="0,5"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="File URL:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="txtFileUrl" Text="..." Margin="0,5" TextWrapping="Wrap"/>
                </Grid>

                <!-- Lyrics -->
                <TextBlock Text="Lời bài hát:" FontWeight="SemiBold" Margin="0,20,0,5"/>
                <Border BorderBrush="#FFDEE2E6" BorderThickness="1" CornerRadius="5" Padding="10">
                    <TextBlock x:Name="txtLyrics" 
                               Text="(Không có)"
                               TextWrapping="Wrap"
                               MaxHeight="150"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Border>

                <Button Content="Đóng"
                        Height="40"
                        Margin="0,20,0,0"
                        Background="#FF6C757D"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnClose_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>