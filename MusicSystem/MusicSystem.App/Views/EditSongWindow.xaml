<Window x:Class="MusicSystem.App.Views.EditSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa thông tin bài hát" 
        Height="500" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="✏️ Sửa thông tin bài hát" 
                       FontSize="20" 
                       FontWeight="Bold"/>
            <TextBlock x:Name="txtSongTitle" 
                       Text="Bài hát: ..." 
                       FontSize="12" 
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="Tiêu đề *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTitle" 
                         Height="35" 
                         Padding="10,0"
                         FontSize="13"
                         Margin="0,0,0,15"/>

                <!-- Genre -->
                <TextBlock Text="Thể loại" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cboGenre" 
                          Height="35" 
                          FontSize="13"
                          Margin="0,0,0,15">
                    <ComboBoxItem Content="Pop"/>
                    <ComboBoxItem Content="Rock"/>
                    <ComboBoxItem Content="Hip Hop"/>
                    <ComboBoxItem Content="R&amp;B"/>
                    <ComboBoxItem Content="EDM"/>
                    <ComboBoxItem Content="Jazz"/>
                    <ComboBoxItem Content="V-Pop"/>
                    <ComboBoxItem Content="K-Pop"/>
                </ComboBox>

                <!-- Release Year -->
                <TextBlock Text="Năm phát hành" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtReleaseYear" 
                         Height="35" 
                         Padding="10,0"
                         FontSize="13"
                         Margin="0,0,0,15"/>

                <!-- Lyrics -->
                <TextBlock Text="Lời bài hát" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLyrics" 
                         Height="120" 
                         Padding="10"
                         FontSize="13"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15"/>

                <!-- Error message -->
                <Border x:Name="errorBorder"
                        Background="#FFFFE5E5"
                        BorderBrush="#FFFF6B6B"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Visibility="Collapsed">
                    <TextBlock x:Name="txtError" 
                               Foreground="#FFC0392B"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnCancel"
                    Content="Hủy"
                    Height="40"
                    Margin="0,0,5,0"
                    Background="#FF6C757D"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnCancel_Click"/>

            <Button Grid.Column="1"
                    x:Name="btnSave"
                    Content="Lưu"
                    Height="40"
                    Margin="5,0,0,0"
                    Background="#FF28A745"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Window>