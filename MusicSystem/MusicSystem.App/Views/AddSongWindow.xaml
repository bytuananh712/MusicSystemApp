<Window x:Class="MusicSystem.App.Views.AddSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm bài hát mới" 
        Height="650" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="🎵 Thêm bài hát mới" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- File Upload -->
                <Border Background="#FFF0F8FF" 
                        BorderBrush="#FF1E90FF"
                        BorderThickness="2"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="📁 Chọn file nhạc *" 
                                   FontWeight="Bold" 
                                   FontSize="13"
                                   Margin="0,0,0,10"/>

                        <Button x:Name="btnSelectFile"
                                Content="🎼 Chọn file MP3/FLAC..."
                                Height="40"
                                Background="#FF1E90FF"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="13"
                                Click="btnSelectFile_Click"/>

                        <Border x:Name="fileInfoPanel"
                                Background="White"
                                BorderBrush="#FFE0E0E0"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10"
                                Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="txtFileName" 
                                           Text="File: song.mp3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtFileSize" 
                                           Text="Size: 5.2 MB"
                                           FontSize="11"
                                           Foreground="Gray"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Title -->
                <TextBlock Text="Tiêu đề bài hát *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTitle" 
                         Height="35" 
                         Padding="10,0"
                         FontSize="13"
                         Margin="0,0,0,15"/>

                <!-- Artists -->
                <TextBlock Text="Nghệ sĩ *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="lstSelectedArtists"
                             Grid.Column="0"
                             Height="80"
                             BorderBrush="#FFDEE2E6"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Column="1"
                            Content="+ Chọn"
                            Width="70"
                            Height="80"
                            Margin="5,0,0,0"
                            Background="#FF17A2B8"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnSelectArtists_Click"/>
                </Grid>

                <!-- Genre -->
                <TextBlock Text="Thể loại" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cboGenre" 
                          Height="35" 
                          FontSize="13"
                          Margin="0,0,0,15">
                    <ComboBoxItem Content="Pop" IsSelected="True"/>
                    <ComboBoxItem Content="Rock"/>
                    <ComboBoxItem Content="Hip Hop"/>
                    <ComboBoxItem Content="R&amp;B"/>
                    <ComboBoxItem Content="EDM"/>
                    <ComboBoxItem Content="Jazz"/>
                    <ComboBoxItem Content="Classical"/>
                    <ComboBoxItem Content="Country"/>
                    <ComboBoxItem Content="V-Pop"/>
                    <ComboBoxItem Content="K-Pop"/>
                </ComboBox>

                <!-- Release Year -->
                <TextBlock Text="Năm phát hành" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtReleaseYear" 
                         Height="35" 
                         Padding="10,0"
                         FontSize="13"
                         Margin="0,0,0,15"/>

                <!-- Lyrics -->
                <TextBlock Text="Lời bài hát" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLyrics" 
                         Height="100" 
                         Padding="10"
                         FontSize="13"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15"/>

                <!-- Progress Bar -->
                <Border x:Name="progressPanel"
                        Background="#FFF0F8FF"
                        BorderBrush="#FF1E90FF"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="txtProgress" 
                                   Text="Đang upload..."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <ProgressBar x:Name="progressBar"
                                     Height="20"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"/>
                    </StackPanel>
                </Border>

                <!-- Error message -->
                <Border x:Name="errorBorder"
                        Background="#FFFFE5E5"
                        BorderBrush="#FFFF6B6B"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,0,0,15"
                        Visibility="Collapsed">
                    <TextBlock x:Name="txtError" 
                               Foreground="#FFC0392B"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnCancel"
                    Content="Hủy"
                    Height="45"
                    Margin="0,0,5,0"
                    Background="#FF6C757D"
                    Foreground="White"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnCancel_Click"/>

            <Button Grid.Column="1"
                    x:Name="btnSave"
                    Content="💾 Lưu"
                    Height="45"
                    Margin="5,0,0,0"
                    Background="#FF28A745"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Window>