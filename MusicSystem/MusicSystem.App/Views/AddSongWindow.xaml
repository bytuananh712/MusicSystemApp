<Window x:Class="MusicSystem.App.Views.AddSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm bài hát mới"
        Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0"
                   Text="🎵 Thêm bài hát mới"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">

                    <!-- FILE -->
                    <Border Background="#FFF0F8FF"
                            BorderBrush="#FF1E90FF"
                            BorderThickness="2"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="📁 Chọn file nhạc *"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <Button x:Name="btnSelectFile"
                                    Content="🎼 Chọn file MP3/FLAC"
                                    Height="40"
                                    Background="#FF1E90FF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="btnSelectFile_Click"/>

                            <Border x:Name="fileInfoPanel"
                                    Background="White"
                                    BorderBrush="#FFE0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed">

                                <StackPanel>
                                    <TextBlock x:Name="txtFileName"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtFileSize"
                                               Foreground="Gray"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- TITLE -->
                    <TextBlock Text="Tiêu đề bài hát *"/>
                    <TextBox x:Name="txtTitle"
                             Height="35"
                             Margin="0,0,0,15"/>

                    <!-- GENRE -->
                    <TextBlock Text="Thể loại"/>
                    <ComboBox x:Name="cboGenre"
                              Height="35"
                              Margin="0,0,0,15">
                        <ComboBoxItem Content="Pop"/>
                        <ComboBoxItem Content="Rock"/>
                        <ComboBoxItem Content="Hip Hop"/>
                        <ComboBoxItem Content="R&amp;B"/>
                        <ComboBoxItem Content="EDM"/>
                        <ComboBoxItem Content="Jazz"/>
                        <ComboBoxItem Content="Classical"/>
                        <ComboBoxItem Content="Country"/>
                        <ComboBoxItem Content="V-Pop"/>
                        <ComboBoxItem Content="K-Pop"/>
                    </ComboBox>

                    <!-- YEAR -->
                    <TextBlock Text="Năm phát hành"/>
                    <TextBox x:Name="txtReleaseYear"
                             Height="35"/>

                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">

                    <!-- ARTISTS -->
                    <TextBlock Text="Nghệ sĩ *"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="lstSelectedArtists"
                                 Height="40"
                                 BorderBrush="#FFDEE2E6"
                                 BorderThickness="1"/>

                        <Button Grid.Column="1"
                                Content="+"
                                Width="40"
                                Margin="5,0,0,0"
                                Background="#FF17A2B8"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btnSelectArtists_Click"/>
                    </Grid>

                    <!-- LYRICS -->
                    <TextBlock Text="Lời bài hát"/>
                    <TextBox x:Name="txtLyrics"
                             Height="200"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,15"/>

                    <!-- PROGRESS -->
                    <Border x:Name="progressPanel"
                            Background="#FFF0F8FF"
                            BorderBrush="#FF1E90FF"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,0,0,15"
                            Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock x:Name="txtProgress"
                                       Text="Đang upload..."
                                       Margin="0,0,0,5"/>
                            <ProgressBar x:Name="progressBar"
                                         Height="20"
                                         Minimum="0"
                                         Maximum="100"/>
                        </StackPanel>
                    </Border>

                    <!-- ERROR -->
                    <Border x:Name="errorBorder"
                            Background="#FFFFE5E5"
                            BorderBrush="#FFFF6B6B"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Visibility="Collapsed">

                        <TextBlock x:Name="txtError"
                                   Foreground="#FFC0392B"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- BUTTON -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnCancel"
                    Content="Hủy"
                    Height="45"
                    Margin="0,0,5,0"
                    Background="#FF6C757D"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnCancel_Click"/>

            <Button Grid.Column="1"
                    x:Name="btnSave"
                    Content="💾 Lưu"
                    Height="45"
                    Margin="5,0,0,0"
                    Background="#FF28A745"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnSave_Click"/>
        </Grid>

    </Grid>
</Window>