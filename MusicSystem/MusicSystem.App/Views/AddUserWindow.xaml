<Window x:Class="MusicSystem.App.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm người dùng mới" 
        Height="450" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0" 
                   Text="➕ Thêm người dùng mới" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">

                    <!-- Username -->
                    <TextBlock Text="Username *" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtUsername"
                             Height="35"
                             Margin="0,0,0,15"/>

                    <!-- Email -->
                    <TextBlock Text="Email *" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtEmail"
                             Height="35"
                             Margin="0,0,0,15"/>

                    <!-- Full Name -->
                    <TextBlock Text="Họ và tên *" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtFullName"
                             Height="35"
                             Margin="0,0,0,15"/>

                    <!-- Role -->
                    <TextBlock Text="Vai trò" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtRole"
                             Text="Customer"
                             IsReadOnly="True"
                             Background="#F3F4F6"
                             Foreground="#6B7280"
                             Height="35"
                             Margin="0,0,0,15"/>

                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">

                    <!-- Password -->
                    <TextBlock Text="Mật khẩu *" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="txtPassword"
                                 Height="35"
                                 Margin="0,0,0,15"/>

                    <!-- Confirm Password -->
                    <TextBlock Text="Xác nhận mật khẩu *" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="txtConfirmPassword"
                                 Height="35"
                                 Margin="0,0,0,15"/>

                    <!-- Error -->
                    <Border x:Name="errorBorder"
                            Background="#FFFFE5E5"
                            BorderBrush="#FFFF6B6B"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Visibility="Collapsed">

                        <TextBlock x:Name="txtError"
                                   Foreground="#FFC0392B"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- BUTTON -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnCancel"
                    Content="Hủy"
                    Height="40"
                    Margin="0,0,5,0"
                    Background="#FF6C757D"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnCancel_Click"/>

            <Button Grid.Column="1"
                    x:Name="btnSave"
                    Content="Lưu"
                    Height="40"
                    Margin="5,0,0,0"
                    Background="#FF28A745"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnSave_Click"/>
        </Grid>

    </Grid>
</Window>