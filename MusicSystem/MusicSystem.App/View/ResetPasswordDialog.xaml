<Window x:Class="MusicSystem.App.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset mật khẩu" 
        Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔄 Reset mật khẩu" 
                       FontSize="18" 
                       FontWeight="Bold"/>
            <TextBlock x:Name="txtUsername" 
                       Text="Username: admin" 
                       FontSize="12" 
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Mật khẩu mới *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtNewPassword" 
                         Height="35" 
                         Padding="10,0"
                         FontSize="13"
                         Margin="0,0,0,15"/>

            <TextBlock Text="Lưu ý: Mật khẩu phải có ít nhất 6 ký tự" 
                       FontSize="11" 
                       Foreground="Gray"
                       FontStyle="Italic"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnCancel"
                    Content="Hủy"
                    Height="40"
                    Margin="0,0,5,0"
                    Background="#FF6C757D"
                    Foreground="White"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnCancel_Click"/>

            <Button Grid.Column="1"
                    x:Name="btnOk"
                    Content="Xác nhận"
                    Height="40"
                    Margin="5,0,0,0"
                    Background="#FFDC3545"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnOk_Click"/>
        </Grid>
    </Grid>
</Window>