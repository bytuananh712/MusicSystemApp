<Page x:Class="MusicSystem.App.Views.Pages.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicSystem.App.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Quản lý người dùng"
      Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="👥 Quản lý người dùng" 
                   FontSize="24" 
                   FontWeight="Bold"/>
            <TextBlock Text="Thêm, sửa, xóa và phân quyền người dùng trong hệ thống" 
                   FontSize="12" 
                   Foreground="Gray"
                   Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" 
            Background="#FFF8F9FA" 
            Padding="15"
            CornerRadius="5"
            Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="txtSearch" 
                         Width="300" 
                         Height="35"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         FontSize="13"
                         BorderBrush="#FFDEE2E6"
                         BorderThickness="1"/>
                    <Button Content="🔍 Tìm kiếm" 
                        Width="100" 
                        Height="35"
                        Margin="10,0,0,0"
                        Background="#FF6C757D"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnSearch_Click"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnAddUser"
                        Content="➕ Thêm người dùng"
                        Height="35"
                        Padding="20,0"
                        Background="#FF28A745"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnAddUser_Click"/>

                    <Button x:Name="btnRefresh"
                        Content="🔄"
                        Width="35"
                        Height="35"
                        Margin="10,0,0,0"
                        Background="#FF17A2B8"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnRefresh_Click"
                        ToolTip="Làm mới danh sách"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" 
            BorderBrush="#FFDEE2E6" 
            BorderThickness="1"
            CornerRadius="5">
            <DataGrid x:Name="dgUsers"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeight="40"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF8F9FA">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" 
                                    Binding="{Binding Username}" 
                                    Width="120"
                                    FontWeight="SemiBold"/>

                    <DataGridTextColumn Header="Email" 
                                    Binding="{Binding Email}" 
                                    Width="200"/>

                    <DataGridTextColumn Header="Họ tên" 
                                    Binding="{Binding FullName}" 
                                    Width="180"/>

                    <DataGridTemplateColumn Header="Roles" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Roles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FF007BFF" 
                                                CornerRadius="3" 
                                                Padding="5,2"
                                                Margin="2">
                                                <TextBlock Text="{Binding}" 
                                                       Foreground="White" 
                                                       FontSize="10"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Trạng thái" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                    CornerRadius="3"
                                    Padding="8,3">
                                    <TextBlock Text="{Binding Status}" 
                                           Foreground="White" 
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Tạo lúc" 
                                    Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" 
                                    Width="130"/>

                    <DataGridTemplateColumn Header="Thao tác" Width="*" MinWidth="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️ Sửa" 
                                        Padding="10,3"
                                        Margin="2"
                                        Background="#FFFFC107"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="btnEdit_Click"
                                        Tag="{Binding UserId}"/>

                                    <Button Content="🔑 Role" 
                                        Padding="10,3"
                                        Margin="2"
                                        Background="#FF17A2B8"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="btnAssignRole_Click"
                                        Tag="{Binding UserId}"/>

                                    <Button Content="🔒 Khóa" 
                                        Padding="10,3"
                                        Margin="2"
                                        Background="#FFDC3545"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="btnDisable_Click"
                                        Tag="{Binding UserId}"
                                        Visibility="{Binding Status, Converter={StaticResource ActiveToVisibilityConverter}}"/>

                                    <Button Content="✅ Mở" 
                                        Padding="10,3"
                                        Margin="2"
                                        Background="#FF28A745"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="btnEnable_Click"
                                        Tag="{Binding UserId}"
                                        Visibility="{Binding Status, Converter={StaticResource DisabledToVisibilityConverter}}"/>

                                    <Button Content="🔄 Reset PW" 
                                        Padding="10,3"
                                        Margin="2"
                                        Background="#FF6C757D"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="btnResetPassword_Click"
                                        Tag="{Binding UserId}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" 
            Background="#FFF8F9FA"
            Padding="15"
            Margin="0,15,0,0"
            CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="txtStatus" 
                       Text="Tổng: 0 người dùng"
                       FontSize="12"
                       Foreground="Gray"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
