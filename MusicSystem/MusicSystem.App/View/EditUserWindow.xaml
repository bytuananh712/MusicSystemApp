<Window x:Class="MusicSystem.App.Views.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa thông tin người dùng" 
        Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="✏️ Sửa thông tin người dùng" 
                       FontSize="20" 
                       FontWeight="Bold"/>
            <TextBlock x:Name="txtUsername" 
                       Text="Username: admin" 
                       FontSize="12" 
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <!-- Email -->
            <TextBlock Text="Email *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" 
                     Height="35" 
                     Padding="10,0"
                     FontSize="13"
                     Margin="0,0,0,15"/>

            <!-- Full Name -->
            <TextBlock Text="Họ và tên *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFullName" 
                     Height="35" 
                     Padding="10,0"
                     FontSize="13"
                     Margin="0,0,0,15"/>

            <!-- Error message -->
            <Border x:Name="errorBorder"
                    Background="#FFFFE5E5"
                    BorderBrush="#FFFF6B6B"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,0,0,15"
                    Visibility="Collapsed">
                <TextBlock x:Name="txtError" 
                           Foreground="#FFC0392B"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnCancel"
                    Content="Hủy"
                    Height="40"
                    Margin="0,0,5,0"
                    Background="#FF6C757D"
                    Foreground="White"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnCancel_Click"/>

            <Button Grid.Column="1"
                    x:Name="btnSave"
                    Content="Lưu"
                    Height="40"
                    Margin="5,0,0,0"
                    Background="#FF28A745"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Window>