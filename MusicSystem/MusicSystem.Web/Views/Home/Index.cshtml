@model IEnumerable<MusicSystem.Shared.DTOs.Songs.SongDto>
@{
    bool isSearch = !string.IsNullOrEmpty(ViewBag.SearchQuery as string);
    ViewData["Title"] = isSearch ? $"Kết quả: {ViewBag.SearchQuery}" : "Trang chủ";
    Layout = "_CustomerLayout";

    var allSongs = Model.ToList();
    // Top Trending: top 5 by TotalPlays
    var trending = allSongs.OrderByDescending(s => s.TotalPlays).Take(5).ToList();
    // Genre chips: extract unique artists as categories
    var artists = allSongs.Select(s => s.Artists?.Split(',')[0].Trim()).Where(a => !string.IsNullOrEmpty(a)).Distinct().Take(8).ToList();
    long totalPlays = allSongs.Sum(s => (long)s.TotalPlays);
    int totalLikes = allSongs.Sum(s => s.TotalLikes);
}

@if (!isSearch && User.Identity?.IsAuthenticated == true)
{
    <!-- ===== HERO BANNER ===== -->
    <div id="heroBanner" style="position: relative; border-radius: 24px; padding: 56px 44px; margin-bottom: 32px; background: url('https://images.unsplash.com/photo-1470229722913-7c092bce65f4?q=80&w=2000&auto=format&fit=crop') center/cover; box-shadow: 0 20px 48px rgba(0,0,0,0.55); overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; min-height: 280px;">
        <div style="position: absolute; inset: 0; background: linear-gradient(to right, rgba(10,10,12,0.95) 0%, rgba(10,10,12,0.55) 55%, transparent 100%);"></div>
        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,12,1) 0%, transparent 60%);"></div>
        <!-- Live clock -->
        <div style="position: absolute; top: 24px; right: 32px; z-index: 2; background: rgba(255,255,255,0.07); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 100px; padding: 7px 18px; font-size: 13px; color: rgba(255,255,255,0.7);">
            <span id="liveClock">--:--</span>
        </div>
        <h1 id="heroGreeting" style="position: relative; z-index: 2; font-size: 52px; font-weight: 800; letter-spacing: -1.5px; color: #fff; line-height: 1.15; margin-bottom: 10px;">
            Chào bạn,<br />
            <span style="background: linear-gradient(90deg, #1ed760, #4ade80); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Khám phá hôm nay.</span>
        </h1>
        <p style="position: relative; z-index: 2; color: rgba(255,255,255,0.55); font-size: 16px; font-weight: 400; max-width: 420px; line-height: 1.6;">
            Dảo qua kho nhạc phẩm mới nhất ngay hôm nay.
        </p>
        <div style="position: relative; z-index: 2; margin-top: 20px; display: flex; gap: 12px;">
            <a href="/Playlist" style="background: var(--green); color: #000; padding: 12px 28px; border-radius: 500px; font-weight: 600; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 6px 20px rgba(29,185,84,0.35);">
                <i class="fas fa-play" style="font-size:12px;"></i> Nghe playlist
            </a>
            <a href="/History" style="background: rgba(255,255,255,0.08); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.15); color: rgba(255,255,255,0.85); padding: 12px 28px; border-radius: 500px; font-weight: 500; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                Lịch sử
            </a>
        </div>
    </div>

    <!-- ===== STATS STRIP ===== -->
    @if (allSongs.Any())
    {
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 36px;">
            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 20px 24px; display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(29,185,84,0.1); display: flex; align-items: center; justify-content: center; font-size: 18px; color: var(--green); flex-shrink: 0;">
                    <i class="fas fa-music"></i>
                </div>
                <div>
                    <div style="font-size: 24px; font-weight: 700; color: #fff;">@allSongs.Count</div>
                    <div style="font-size: 12px; color: var(--text-300); margin-top: 1px;">bài hát</div>
                </div>
            </div>
            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 20px 24px; display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(96,165,250,0.1); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #60a5fa; flex-shrink: 0;">
                    <i class="fas fa-play"></i>
                </div>
                <div>
                    <div style="font-size: 24px; font-weight: 700; color: #fff;">@(totalPlays > 999 ? $"{totalPlays / 1000}K" : totalPlays.ToString())</div>
                    <div style="font-size: 12px; color: var(--text-300); margin-top: 1px;">lượt phát</div>
                </div>
            </div>
            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 20px 24px; display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(192,132,252,0.1); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #c084fc; flex-shrink: 0;">
                    <i class="fas fa-heart"></i>
                </div>
                <div>
                    <div style="font-size: 24px; font-weight: 700; color: #fff;">@(totalLikes > 999 ? $"{totalLikes / 1000}K" : totalLikes.ToString())</div>
                    <div style="font-size: 12px; color: var(--text-300); margin-top: 1px;">lượt thích</div>
                </div>
            </div>
        </div>
    }

    <!-- ===== TRENDING ===== -->
    @if (trending.Any())
    {
        <div class="sp-section" style="margin-bottom: 40px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                <span style="font-weight: 700; font-size: 18px; letter-spacing: -0.3px; color: #fff;">Phổ biến nhất</span>
                <span style="font-size: 12px; color: var(--text-300);">Top @trending.Count</span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                @for (int i = 0; i < trending.Count; i++)
                {
                    var song = trending[i];
                    string rankColor = i == 0 ? "#ffd700" : i == 1 ? "#c0c0c0" : i == 2 ? "#cd7f32" : "var(--text-300)";
                    <div class="trending-row" data-song-id="@song.SongId" data-song-title="@song.Title"
                         data-song-artists="@song.Artists" data-song-url="@song.FileUrl"
                         data-song-cover="@song.CoverImageUrl"
                         onclick="playSong(this)"
                         style="display: flex; align-items: center; gap: 16px; padding: 10px 14px; border-radius: 12px; background: transparent; cursor: pointer; transition: background 0.2s ease;"
                         onmouseenter="this.style.background='rgba(255,255,255,0.04)'"
                         onmouseleave="this.style.background='transparent'">
                        <!-- Rank -->
                        <div style="width: 28px; text-align: center; font-size: 14px; font-weight: 600; color: @rankColor; flex-shrink: 0; font-variant-numeric: tabular-nums;">
                            @(i + 1)
                        </div>
                        <!-- Cover -->
                        <div style="width: 52px; height: 52px; border-radius: 10px; overflow: hidden; flex-shrink: 0; background: linear-gradient(135deg, #1a0050, #6b0ac9);">
                            @if (!string.IsNullOrEmpty(song.CoverImageUrl))
                            {
                                <img src="@song.CoverImageUrl" alt="@song.Title" style="width:100%; height:100%; object-fit:cover;">
                            }
                            else
                            {
                                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:20px; color:rgba(255,255,255,0.5);">
                                    <i class="fas fa-music"></i>
                                </div>
                            }
                        </div>
                        <!-- Info -->
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-weight: 600; font-size: 14px; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@song.Title</div>
                            <div style="font-size: 12px; color: var(--text-300); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px;">@song.Artists</div>
                        </div>
                        <!-- Plays badge -->
                        <div style="flex-shrink: 0; text-align: right;">
                            <div style="display: flex; align-items: center; gap: 6px; color: var(--text-200); font-size: 13px;">
                                <i class="fas fa-play" style="font-size:11px; color: var(--green);"></i>
                                <span style="font-weight: 700; font-family: 'Outfit', sans-serif;">@(song.TotalPlays > 999 ? $"{song.TotalPlays / 1000}K" : song.TotalPlays.ToString())</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 6px; color: var(--text-200); font-size: 12px; margin-top: 2px;">
                                <i class="fas fa-heart" style="font-size:10px; color: #c084fc;"></i>
                                <span>@song.TotalLikes</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<!-- ===== GENRE FILTER CHIPS ===== -->
@if (!isSearch && artists.Any())
{
    <div style="margin-bottom: 28px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <button class="genre-chip active" onclick="filterSongs('all', this)"
                style="padding: 8px 20px; border-radius: 500px; border: 1px solid rgba(29,185,84,0.5); background: rgba(29,185,84,0.15); color: var(--green); font-weight: 700; font-size: 13px; cursor: pointer; transition: all 0.3s; font-family: 'Outfit', sans-serif;">
            Tất cả
        </button>
        @foreach (var artist in artists)
        {
            <button class="genre-chip" onclick="filterSongs('@artist', this)"
                    style="padding: 8px 20px; border-radius: 500px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); color: var(--text-200); font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.3s; backdrop-filter: blur(8px); font-family: 'Outfit', sans-serif;">
                @artist
            </button>
        }
    </div>
}

<!-- ===== MAIN SONGS SECTION ===== -->
<div class="sp-section">
    <div class="sp-section-header" style="margin-bottom: 24px;">
        <div class="sp-section-title">
            @if (isSearch)
            {
                <span style="font-size: 32px; font-weight: 900; letter-spacing: -1px;">Kết quả cho "@ViewBag.SearchQuery"</span>
            }
            else
            {
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, #003d1a, #1db954); display: flex; align-items: center; justify-content: center; font-size: 16px;">🎵</div>
                    <span style="font-weight: 900; font-size: 24px; letter-spacing: -0.5px; font-family: 'Outfit', sans-serif;">Gợi ý cho bạn</span>
                </div>
            }
        </div>
        @if (!isSearch)
        {
            <a href="#" class="sp-section-link" style="padding: 8px 16px; background: rgba(255,255,255,0.05); border-radius: 500px; text-decoration: none;">Xem tất cả</a>
        }
        else
        {
            <span style="font-size:14px;color:var(--text-200); background: rgba(255,255,255,0.05); padding: 6px 16px; border-radius: 500px;">@Model.Count() kết quả</span>
        }
    </div>

    @if (Model.Any())
    {
        <div class="songs-grid" id="songsGrid">
            @foreach (var song in Model)
            {
                <div class="song-card" data-song-id="@song.SongId" data-song-title="@song.Title"
                     data-song-artists="@song.Artists" data-song-url="@song.FileUrl"
                     data-song-cover="@song.CoverImageUrl" onclick="playSong(this)">

                    <div class="song-cover">
                        @if (!string.IsNullOrEmpty(song.CoverImageUrl))
                        {
                            <img src="@song.CoverImageUrl" alt="@song.Title" loading="lazy">
                        }
                        else
                        {
                            <i class="fas fa-music" style="font-size:42px;opacity:.4"></i>
                        }
                        <button class="cover-play-btn" onclick="event.stopPropagation(); playSong(this.closest('.song-card'))"
                                title="Phát @song.Title">
                            <i class="fas fa-play" style="margin-left:2px"></i>
                        </button>
                    </div>

                    <div class="song-title" title="@song.Title">@song.Title</div>
                    <div class="song-artist">@song.Artists</div>
                    <div class="song-stats">
                        <span>
                            <i class="fas fa-play"></i> @(song.TotalPlays > 999 ? $"{song.TotalPlays / 1000}K" : song.TotalPlays.ToString())
                        </span>
                        <span><i class="fas fa-heart"></i> @song.TotalLikes</span>
                    </div>

                    <!-- Add to playlist -->
                    <button class="card-add-btn"
                            data-add-song-id="@song.SongId"
                            data-add-song-title="@song.Title"
                            title="Thêm vào playlist">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-music"></i>
            <h3>@(isSearch ? "Không tìm thấy kết quả" : "Chưa có bài hát")</h3>
            <p>@(isSearch ? "Thử tìm kiếm với từ khóa khác" : "Chưa có bài hát nào được duyệt")</p>
        </div>
    }
</div>



@section Scripts {
    <script>
        /* ===== GREETING BY TIME ===== */
        function updateGreeting() {
            const h = new Date().getHours();
            const greetingEl = document.getElementById('heroGreeting');
            if (!greetingEl) return;
            let msg = 'Chào bạn,';
            let sub = 'Khám phá hôm nay.';
            if (h >= 5 && h < 12)       { msg = 'Chào buổi sáng,'; sub = 'Cùng bắt đầu ngày mới với âm nhạc.'; }
            else if (h >= 12 && h < 18) { msg = 'Chào buổi chiều,'; sub = 'Thư giãn một chút với giai điệu yêu thích.'; }
            else if (h >= 18 && h < 22) { msg = 'Chào buổi tối,'; sub = 'Kết thúc ngày dài cùng những giai điệu hay.'; }
            else                         { msg = 'Đang thức khuya?'; sub = 'Để âm nhạc đồng hành cùng bạn.'; }
            greetingEl.innerHTML = `${msg}<br/><span style="background: linear-gradient(90deg, #1ed760, #4ade80); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">${sub}</span>`;
        }

        /* ===== LIVE CLOCK ===== */
        function updateClock() {
            const clockEl = document.getElementById('liveClock');
            if (!clockEl) return;
            const now = new Date();
            clockEl.textContent = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        }

        updateGreeting();
        updateClock();
        setInterval(updateClock, 1000);

        /* ===== GENRE FILTER ===== */
        function filterSongs(artist, btn) {
            // Update chip active state
            document.querySelectorAll('.genre-chip').forEach(c => {
                c.style.background = 'rgba(255,255,255,0.04)';
                c.style.color = 'var(--text-200)';
                c.style.borderColor = 'rgba(255,255,255,0.1)';
                c.classList.remove('active');
            });
            btn.style.background = 'rgba(29,185,84,0.15)';
            btn.style.color = 'var(--green)';
            btn.style.borderColor = 'rgba(29,185,84,0.5)';
            btn.classList.add('active');

            // Filter cards
            document.querySelectorAll('.song-card').forEach(card => {
                const cardArtist = card.dataset.songArtists || '';
                if (artist === 'all' || cardArtist.toLowerCase().includes(artist.toLowerCase())) {
                    card.style.display = '';
                    card.style.animation = 'fadeInCard 0.3s ease forwards';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        /* ===== ADD TO PLAYLIST ===== */
        let _addSongId = null;

        // --- Event delegation cho nút "+" trên song cards ---
        document.addEventListener('click', function(e) {
            const addBtn = e.target.closest('.card-add-btn');
            if (!addBtn) return;

            e.stopPropagation(); // Không trigger playSong

            const songId = addBtn.dataset.addSongId;
            const songTitle = addBtn.dataset.addSongTitle;

            if (!songId) {
                console.error('[AddToPlaylist] Không tìm thấy songId trên nút');
                return;
            }

            console.log('[AddToPlaylist] Mở modal cho song:', songId, songTitle);

            // Kiểm tra auth (rendered by Razor server-side)
            const isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
            if (!isAuthenticated) {
                if (confirm('Đăng nhập để thêm vào playlist?'))
                    window.location.href = '/Account/Login';
                return;
            }

            _addSongId = songId;
            document.getElementById('selectedSongTitle').textContent = songTitle || '';
            new bootstrap.Modal(document.getElementById('addToPlaylistModal')).show();
            _loadPlaylists();
        });

        // --- Load danh sách playlist vào modal ---
        async function _loadPlaylists() {
            const listEl = document.getElementById('playlistList');
            listEl.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-light"></div></div>';
            try {
                const res = await fetch('/Playlist/GetUserPlaylists');
                console.log('[LoadPlaylists] Response status:', res.status);

                const data = await res.json();
                console.log('[LoadPlaylists] Data:', data);

                if (!data.success || !data.playlists || !data.playlists.length) {
                    listEl.innerHTML = '<p style="color:var(--text-200);font-size:13px;text-align:center;padding:16px 0">Chưa có playlist. Hãy tạo mới!</p>';
                    return;
                }

                // Render bằng data-attributes, KHÔNG dùng inline onclick
                listEl.innerHTML = data.playlists.map(function(p) {
                    var safeName = (p.playlistName || '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
                    return '<button type="button" class="playlist-modal-item" data-pl-id="' + p.playlistId + '" data-pl-name="' + safeName + '">' +
                        '<div class="playlist-modal-icon"><i class="fas fa-music"></i></div>' +
                        '<span class="playlist-modal-name">' + safeName + '</span>' +
                        '<span class="playlist-modal-count">' + (p.songCount || 0) + ' bài</span>' +
                    '</button>';
                }).join('');

                console.log('[LoadPlaylists] Rendered', data.playlists.length, 'playlists');
            } catch (e) {
                console.error('[LoadPlaylists] Error:', e);
                listEl.innerHTML = '<p style="color:#f87171;font-size:13px">Lỗi: ' + e.message + '</p>';
            }
        }

        // --- Event delegation cho click playlist item trong modal ---
        document.getElementById('playlistList').addEventListener('click', function(e) {
            var btn = e.target.closest('.playlist-modal-item');
            if (!btn) return;

            var plId = btn.getAttribute('data-pl-id');
            var plName = btn.getAttribute('data-pl-name');

            console.log('[PlaylistClick] Clicked playlist:', plId, plName, 'songId:', _addSongId);

            if (plId && _addSongId) {
                _addToPlaylist(plId, plName);
            } else {
                console.error('[PlaylistClick] Missing plId or _addSongId:', plId, _addSongId);
            }
        });

        // --- Gửi request thêm bài hát vào playlist ---
        async function _addToPlaylist(plId, name) {
            console.log('[_addToPlaylist] Sending request:', { playlistId: plId, songId: _addSongId });
            try {
                var res = await fetch('/Playlist/AddSong', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'playlistId=' + encodeURIComponent(plId) + '&songId=' + encodeURIComponent(_addSongId)
                });

                console.log('[_addToPlaylist] Response status:', res.status, 'redirected:', res.redirected);

                // Nếu bị redirect về trang login
                if (res.redirected || res.status === 401 || res.status === 403) {
                    bootstrap.Modal.getInstance(document.getElementById('addToPlaylistModal'))?.hide();
                    showToast('Phiên đăng nhập hết hạn, vui lòng đăng nhập lại', 'error');
                    setTimeout(function() { window.location.href = '/Account/Login'; }, 1500);
                    return;
                }

                var contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    var text = await res.text();
                    console.error('[_addToPlaylist] Non-JSON response:', text.substring(0, 200));
                    throw new Error('Server không trả về JSON');
                }

                var data = await res.json();
                console.log('[_addToPlaylist] Result:', data);

                bootstrap.Modal.getInstance(document.getElementById('addToPlaylistModal'))?.hide();
                if (data.success) {
                    showToast('Đã lưu vào "' + (name || 'playlist') + '"');
                } else {
                    showToast('Lỗi: ' + (data.message || 'Không rõ'), 'error');
                }
            } catch (e) {
                console.error('[_addToPlaylist] Error:', e);
                bootstrap.Modal.getInstance(document.getElementById('addToPlaylistModal'))?.hide();
                showToast('Lỗi kết nối: ' + e.message, 'error');
            }
        }

        function _esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
    </script>
}