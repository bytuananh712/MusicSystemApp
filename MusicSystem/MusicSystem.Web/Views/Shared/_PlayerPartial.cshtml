<div class="player-bar" id="playerBar" style="display: none;">
    <div class="row align-items-center">
        <div class="col-md-3">
            <div class="player-info">
                <div class="player-cover"><i class="fas fa-music"></i></div>
                <div>
                    <div class="fw-bold" id="currentSongTitle">Chọn bài hát</div>
                    <div class="text-muted small" id="currentSongArtist">Nghệ sĩ</div>
                </div>
                <button class="btn btn-link text-white" id="btnLike"><i class="far fa-heart"></i></button>
            </div>
        </div>

        <div class="col-md-6 text-center">
            <div class="player-controls justify-content-center mb-2">
                <button class="btn-player" id="btnPrevious"><i class="fas fa-step-backward"></i></button>
                <button class="btn-player play-btn" id="btnPlay"><i class="fas fa-play-circle"></i></button>
                <button class="btn-player" id="btnNext"><i class="fas fa-step-forward"></i></button>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="small" id="currentTime">0:00</span>
                <div class="progress-bar-custom flex-grow-1" id="progressBar">
                    <div class="progress" id="progress" style="width: 0%"></div>
                </div>
                <span class="small" id="duration">0:00</span>
            </div>
        </div>

        <div class="col-md-3 text-end">
            <div class="volume-control justify-content-end">
                <button class="btn-player" id="btnVolume"><i class="fas fa-volume-up"></i></button>
                <input type="range" class="form-range volume-slider" id="volumeSlider" min="0" max="100" value="80">
            </div>
        </div>
    </div>
    <audio id="audioPlayer"></audio>
</div>