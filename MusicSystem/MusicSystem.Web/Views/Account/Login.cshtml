@model MusicSystem.Shared.DTOs.Auth.LoginRequestDto
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng nhập — Make By Tuan Anh";
}

<div class="page-wrapper">

    <!-- ===== LEFT: Branding ===== -->
    <div class="brand-side">
        <div class="brand-content">
            <!-- Logo -->
            <div class="brand-logo-wrap">
                <img width="48" height="48" src="https://img.icons8.com/color/48/alligator.png" alt="alligator" />
                <span class="brand-logo-text">Make By Tuan Anh</span>
            </div>

            <h1>Không gian nghe nhạc.
                <br><em> Đẳng cấp.</em></h1>
            <p>Đăng nhập để nghe nhạc, tạo playlist, và khám phá âm nhạc không giới hạn.</p>

            <div class="brand-pills">
                <div class="brand-pill"><i class="fas fa-music"></i> Hàng triệu bài hát</div>
                <div class="brand-pill"><i class="fas fa-list-music"></i> Playlist cá nhân</div>
                <div class="brand-pill"><i class="fas fa-clock-rotate-left"></i> Lịch sử nghe</div>
            </div>
        </div>
    </div>

    <!-- ===== RIGHT: Form ===== -->
    <div class="form-side">
        <div class="form-container">

            <div class="form-header">
                <h2>Đăng nhập</h2>
                <p>Tiếp tục trải nghiệm MusicSystem</p>
            </div>

            <form asp-action="Login" method="post" id="loginForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Username -->
                <div class="form-group">
                    <label asp-for="Username">Tên đăng nhập</label>
                    <div class="input-box">
                        <i class="fas fa-user prefix-icon"></i>
                        <input asp-for="Username" class="form-control" placeholder="Tên tài khoản hoặc email" autofocus
                               autocomplete="username" />
                    </div>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label asp-for="Password">Mật khẩu</label>
                    <div class="input-box">
                        <i class="fas fa-lock prefix-icon"></i>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu"
                               autocomplete="current-password" />
                        <i class="fas fa-eye eye-btn" id="togglePass"></i>
                    </div>
                </div>

                <!-- Remember / Forgot -->
                <div class="form-row">
                    <label class="remember-label">
                        <input asp-for="RememberMe" type="checkbox" />
                        Ghi nhớ tôi
                    </label>
                    <a href="#" class="forgot-link">Quên mật khẩu?</a>
                </div>

                <!-- Submit (Spotify green pill button) -->
                <button type="submit" class="btn-login" id="submitBtn">
                    <span id="btnTxt">ĐĂNG NHẬP</span>
                </button>
            </form>

            <!-- Demo accounts -->
            <div class="divider">
                <span class="divider-text">HOẶC DÙNG TÀI KHOẢN MẪU</span>
            </div>
            <div class="demo-accounts">
                <div class="demo-chip" onclick="autoFill('customer1','customer123')" title="Customer1 / customer123">
                    👑 customer1
                </div>
                <div class="demo-chip" onclick="autoFill('customer2','Customer123')" title="Customer2 / Customer123">
                    👑 Customer2
                </div>
                <div class="demo-chip" onclick="autoFill('customer2','Customer123')" title="Customer3 / Customer123">
                    👑 Customer3
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/auth/login.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle password visibility
        document.getElementById('togglePass')?.addEventListener('click', function () {
            const input = document.querySelector('input[name="Password"]');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            this.className = show ? 'fas fa-eye-slash eye-btn' : 'fas fa-eye eye-btn';
        });

        // Auto-fill demo accounts
        function autoFill(user, pass) {
            document.querySelector('input[name="Username"]').value = user;
            document.querySelector('input[name="Password"]').value = pass;
        }

        // Loading state on submit
        document.getElementById('loginForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            const txt = document.getElementById('btnTxt');
            btn.disabled = true;
            txt.innerHTML = '⏳ Đang đăng nhập...';
        });
    </script>
}