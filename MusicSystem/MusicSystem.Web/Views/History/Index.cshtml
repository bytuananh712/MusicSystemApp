@model IEnumerable<MusicSystem.Shared.DTOs.Songs.HistoryDto>
@{
    ViewData["Title"] = "Lịch sử nghe";
    Layout = "_CustomerLayout";

    // Grouping logic
    var now = DateTime.UtcNow;
    var today = Model.Where(h => h.PlayedAt.Date == now.Date);
    var yesterday = Model.Where(h => h.PlayedAt.Date == now.Date.AddDays(-1));
    var earlier = Model.Where(h => h.PlayedAt.Date < now.Date.AddDays(-1));
}

<style>
    .history-page {
        padding: 32px 0;
    }

    .history-section {
        margin-bottom: 48px;
    }

    .section-title {
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 24px;
        color: var(--text-100);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .section-title::after {
        content: "";
        flex: 1;
        height: 1px;
        background: rgba(255, 255, 255, 0.06);
    }

    /* Compact Grid Layout */
    .history-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 20px;
    }

    .history-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .history-card:hover {
        background: rgba(255, 255, 255, 0.08);
        transform: translateY(-4px);
        border-color: var(--green);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
    }

    .card-media {
        position: relative;
        aspect-ratio: 1;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 12px;
        background: linear-gradient(135deg, #282828, #121212);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
    }

    .card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-media .fallback-icon {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        color: rgba(255, 255, 255, 0.2);
    }

    /* Floating Play Button */
    .card-play-btn {
        position: absolute;
        bottom: 8px;
        right: 8px;
        width: 40px;
        height: 40px;
        background: var(--green);
        border: none;
        border-radius: 50%;
        color: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        opacity: 0;
        transform: translateY(8px);
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(29, 185, 84, 0.4);
    }

    .history-card:hover .card-play-btn {
        opacity: 1;
        transform: translateY(0);
    }

    .card-play-btn:hover {
        transform: scale(1.1);
        background: var(--green-bright);
    }

    .card-content {
        min-width: 0;
    }

    .card-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-100);
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-artist {
        font-size: 12px;
        color: var(--text-200);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-time {
        font-size: 11px;
        color: var(--text-300);
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Empty State */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 100px 20px;
        text-align: center;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 24px;
        border: 1px dashed rgba(255, 255, 255, 0.1);
    }
</style>

<div class="history-page">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div style="font-size: 64px; color: rgba(255,255,255,0.1); margin-bottom: 24px;">
                <i class="fas fa-history"></i>
            </div>
            <h2 style="font-weight: 800; margin-bottom: 8px;">Chưa có lịch sử nghe</h2>
            <p style="color: var(--text-200); margin-bottom: 32px;">Hãy bắt đầu hành trình âm nhạc của bạn ngay bây giờ!</p>
            <a href="/" class="sp-btn-primary" style="text-decoration:none;">Khám phá ngay</a>
        </div>
    }
    else
    {
        @if (today.Any())
        {
            <div class="history-section">
                <h2 class="section-title">Hôm nay</h2>
                <div class="history-grid">
                    @foreach (var item in today)
                    {
                        @Html.Partial("_HistoryCard", item)
                    }
                </div>
            </div>
        }

        @if (yesterday.Any())
        {
            <div class="history-section">
                <h2 class="section-title">Hôm qua</h2>
                <div class="history-grid">
                    @foreach (var item in yesterday)
                    {
                        @Html.Partial("_HistoryCard", item)
                    }
                </div>
            </div>
        }

        @if (earlier.Any())
        {
            <div class="history-section">
                <h2 class="section-title">Trước đó</h2>
                <div class="history-grid">
                    @foreach (var item in earlier)
                    {
                        @Html.Partial("_HistoryCard", item)
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function playHistorySong(id, title, artists, url) {
            if (!id || !url) return;
            playSong({
                dataset: {
                    songId: id,
                    songTitle: title,
                    songArtists: artists,
                    songUrl: url
                }
            });
        }
    </script>
}