@model IEnumerable<MusicSystem.Shared.DTOs.Songs.HistoryDto>
@{
    ViewData["Title"] = "Lịch sử nghe";
    Layout = "_CustomerLayout";
    int rownum = 1;
}

<div class="sp-section">
    <div class="sp-section-header">
        <div class="sp-section-title">Đã nghe gần đây</div>
        <span style="font-size:13px;color:var(--text-200)">@Model.Count() bài</span>
    </div>

    @if (Model.Any())
    {
        <table class="history-table">
            <thead class="history-thead">
                <tr>
                    <th style="width:40px;text-align:center">#</th>
                    <th style="width:48px"></th>
                    <th>Tiêu đề</th>
                    <th class="d-none d-md-table-cell">Nghệ sĩ</th>
                    <th class="d-none d-lg-table-cell" style="width:120px">Thời gian</th>
                    <th style="width:48px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var songId = item.SongId;
                    var title = item.Title;
                    var artists = item.Artists;

                    var diff = DateTime.UtcNow - item.PlayedAt;
                    var timeAgo = diff.TotalMinutes < 1 ? "Vừa xong"
                    : diff.TotalHours < 1 ? $"{(int)diff.TotalMinutes} phút"
                    : diff.TotalDays < 1 ? $"{(int)diff.TotalHours} giờ"
                    : diff.TotalDays < 7 ? $"{(int)diff.TotalDays} ngày"
                    : item.PlayedAt.ToString("dd/MM/yy");

                    var safetitle = (title ?? "").Replace("'", "\\'").Replace("\"", "\\\"");
                    var safeartists = (artists ?? "").Replace("'", "\\'").Replace("\"", "\\\"");
                    var safeUrl = item.FileUrl ?? "";

                    <tr class="history-row" onclick="playHistorySong('@songId','@safetitle','@safeartists','@safeUrl')">
                        <td style="width:40px">
                            <span class="h-num">@rownum</span>
                            <span class="h-play-icon"><i class="fas fa-play"></i></span>
                        </td>
                        <td style="width:48px">
                            <div class="h-thumb"><i class="fas fa-music"></i></div>
                        </td>
                        <td>
                            <div class="h-info-title" title="@title">@(title ?? "Unknown")</div>
                            <div class="h-info-artist d-md-none">@artists</div>
                        </td>
                        <td class="h-time d-none d-md-table-cell">@artists</td>
                        <td class="h-time d-none d-lg-table-cell">@timeAgo</td>
                        <td>
                            <button class="h-play-btn"
                                    onclick="event.stopPropagation(); playHistorySong('@songId','@safetitle','@safeartists','@safeUrl')"
                                    title="Phát">
                                <i class="fas fa-play"></i>
                            </button>
                        </td>
                    </tr>
                    rownum++;
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-clock-rotate-left"></i>
            <h3>Chưa có lịch sử</h3>
            <p>Bắt đầu nghe nhạc để xem lại những gì bạn đã nghe</p>
            <a href="/" class="sp-btn-primary" style="text-decoration:none;display:inline-block;margin-top:8px">
                Khám phá nhạc
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function playHistorySong(id, title, artists, url) {
            if (!id) return;
            playSong({ dataset: { songId: id, songTitle: title, songArtists: artists, songUrl: url } });
        }
    </script>
}